{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "omarchy" -}}
#!/usr/bin/env bash

set -euo pipefail

echo "Setting default apps..."

echo "Setting helium-browser as default"
env -u BROWSER xdg-settings set default-web-browser helium.desktop

echo "Setting ghostty as default"
omarchy-default-terminal ghostty

echo "Finished setting default apps..."
{{ end -}}
{{ end -}}


