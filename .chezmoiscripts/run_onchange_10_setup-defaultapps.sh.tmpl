{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash

set -euo pipefail

echo "Setting default apps..."

# Write to ~/.config/mimeapps.list directly instead of xdg-settings, which
# needs a recognised desktop environment to work reliably.
set_default() {
  local desktop_file="$1"
  shift
  if [[ ! -f "/usr/share/applications/$desktop_file" ]]; then
    echo "Skipping $desktop_file (not installed)"
    return
  fi
  xdg-mime default "$desktop_file" "$@"
}

echo "Browser: Helium"
set_default helium.desktop \
  x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml

echo "File manager: Nautilus"
set_default org.gnome.Nautilus.desktop inode/directory

echo "Images: Loupe"
set_default org.gnome.Loupe.desktop \
  image/png image/jpeg image/gif image/webp image/avif image/bmp image/tiff image/svg+xml

echo "Documents: Papers"
set_default org.gnome.Papers.desktop application/pdf

echo "E-books: Foliate"
set_default com.github.johnfactotum.Foliate.desktop \
  application/epub+zip application/x-mobipocket-ebook application/vnd.amazon.mobi8-ebook

echo "Text: GNOME Text Editor"
set_default org.gnome.TextEditor.desktop text/plain

echo "Video/audio: mpv"
set_default mpv.desktop \
  video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo \
  audio/mpeg audio/flac audio/ogg audio/x-wav

# Terminal: Ghostty is set through ~/.config/xdg-terminals.list (managed by
# chezmoi) for xdg-terminal-exec users. Nautilus "Open in Terminal" and the
# Umbriel keybinds call ghostty directly.

echo "Finished setting default apps..."
{{ end -}}
{{ end -}}
