{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash

set -euo pipefail

echo "Adding current user to libvirt and kvm groups..."

for group in libvirt kvm; do
  if ! getent group "$group" >/dev/null; then
    echo "Creating $group group..."
    sudo groupadd --system "$group"
  fi

  if id -nG "$USER" | grep -qw "$group"; then
    echo "User $USER is already in $group group. Nothing to do."
  else
    sudo usermod -aG "$group" "$USER"
    echo "User $USER added to $group group..."
    echo "⚠️ Log out and back in for the group change to take effect..."
  fi
done

echo "Enabling and starting libvirt..."
sudo systemctl enable --now libvirtd.service

echo "Ensuring the default NAT network is defined and autostarted..."
if ! sudo virsh net-info default >/dev/null 2>&1; then
  sudo virsh net-define /usr/share/libvirt/networks/default.xml
fi

sudo virsh net-autostart default
if ! sudo virsh net-info default | grep -q 'Active:.*yes'; then
  sudo virsh net-start default
fi

echo "Completed libvirt setup..."
{{ end -}}
{{ end -}}
