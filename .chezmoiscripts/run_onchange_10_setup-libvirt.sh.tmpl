{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash

set -euo pipefail

echo "Adding current user to libvirt and kvm groups..."

for group in libvirt kvm; do
  if ! getent group "$group" >/dev/null; then
    echo "Creating $group group..."
    sudo groupadd --system "$group"
  fi

  if id -nG "$USER" | grep -qw "$group"; then
    echo "User $USER is already in $group group. Nothing to do."
  else
    sudo usermod -aG "$group" "$USER"
    echo "User $USER added to $group group..."
    echo "⚠️ Log out and back in for the group change to take effect..."
  fi
done

echo "Enabling and starting libvirt..."
sudo systemctl enable --now libvirtd.service

echo "Ensuring the default NAT network is defined and autostarted..."
if ! sudo virsh net-info default >/dev/null 2>&1; then
  sudo virsh net-define /usr/share/libvirt/networks/default.xml
fi

# Is a /24 (given as "a.b.c") already used by a non-libvirt interface?
subnet_in_use() {
  local addrs
  addrs="$(ip -4 -o addr show | awk '$2 !~ /^virbr/ {print $4}')"
  grep -q "^${1//./\\.}\." <<<"$addrs"
}

net_info="$(sudo virsh net-info default)"
if ! grep -q 'Active:.*yes' <<<"$net_info"; then
  # When this machine is itself a libvirt guest, its NIC usually sits on the
  # host's 192.168.122.0/24 and the default network can't start. Move the
  # inactive default network to the first free 192.168.x.0/24.
  net_xml="$(sudo virsh net-dumpxml --inactive default)"
  gateway="$(sed -n "s/.*<ip address='\([0-9.]*\)'.*/\1/p" <<<"$net_xml" | head -n1)"
  current_subnet="${gateway%.*}"

  if [[ -n "$current_subnet" ]] && subnet_in_use "$current_subnet"; then
    new_subnet=""
    for octet in $(seq 123 254); do
      if ! subnet_in_use "192.168.$octet"; then
        new_subnet="192.168.$octet"
        break
      fi
    done
    if [[ -z "$new_subnet" ]]; then
      echo "Error: no free 192.168.x.0/24 subnet for the default network" >&2
      exit 1
    fi

    echo "Subnet $current_subnet.0/24 is in use; moving default network to $new_subnet.0/24..."
    net_xml_file="$(mktemp)"
    sed "s/${current_subnet//./\\.}\./$new_subnet./g" <<<"$net_xml" >"$net_xml_file"
    sudo virsh net-define "$net_xml_file"
    rm -f "$net_xml_file"
  fi

  sudo virsh net-start default
fi

sudo virsh net-autostart default

echo "Completed libvirt setup..."
{{ end -}}
{{ end -}}
