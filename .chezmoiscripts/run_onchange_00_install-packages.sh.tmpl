{{ if eq .chezmoi.os "linux" -}}
{{ if eq .chezmoi.osRelease.id "arch" -}}
#!/usr/bin/env bash

set  -eufo pipefail

echo -e "Starting setup for Arch Linux packages..."

# Packages provided by Omarchy and intentionally omitted below. Add them back
# if this configuration is used on a plain Arch Linux installation:
#   btop eza fcitx5 fcitx5-gtk fcitx5-qt fzf imagemagick imv lazygit
#   mpv noto-fonts-cjk tmux xdg-desktop-portal
#   xdg-desktop-portal-gtk xdg-desktop-portal-hyprland zoxide
#   mise neovim
# flatseal is installed below as a Flatpak rather than an Arch package.

packages=(
  7zip
  dnsmasq
  duf
  fcitx5-configtool
  fcitx5-mozc
  flatpak
  foliate
  ghostty
  github-cli
  keyd
  libvirt
  openbsd-netcat
  qemu-base
  samba
  tesseract-data-jpn
  ttf-jetbrains-mono
  ttf-jetbrains-mono-nerd
  vde2
  virt-manager
  virt-viewer
  wireguard-tools
  xdg-desktop-portal-kde
  yazi
)

# Packages from the AUR.
aur_packages=(
  anki-bin
  bridge-utils
  helium-browser-bin
)

omarchy pkg add "${packages[@]}"
omarchy pkg aur add "${aur_packages[@]}"

echo "Finished installing Arch Linux packages..."

echo "Installing flatpak and packages..."

if ! flatpak remotes --system | grep -q '^flathub'; then
  sudo flatpak remote-add --system --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
fi

flatpak_apps=(
  com.yacreader.YACReader
  com.github.tchx84.Flatseal
)

for app in "${flatpak_apps[@]}"; do
  sudo flatpak install --system --or-update --noninteractive flathub "$app"
done

sudo flatpak update --system --appstream

echo "Finished installing flatpak and packages..."

{{ end -}}
{{ end -}}
